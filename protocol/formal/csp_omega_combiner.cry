// OpenQPEP Official Release 1.0.0 (v1.0.0) — Cryptol Formal Specification & Proofs
// Target: Calyx Sovereign-Pentad (CSP-Omega) 5-Family Beyond-LWE Combiner
// Theorem: Robust Multi-Assumption Split-Key PRF / Combiner Security:
//   - IND-CCA2 confidentiality holds if ANY 1 of {Plain-LWE (CULC-2048), Binary Goppa Patterson (CGM-8192),
//     CSIDH-512 Supersingular Isogeny (CIF-SQI-512), X448} remains unbroken.
//   - EUF-CMA signature unforgeability holds if ANY 1 of {QHS-512 Hypertree, QMQ-512 UOV Multivariate,
//     CIF-SQI-512 CSIDH-512 SeaSign Isogeny Signature} remains unforgeable.
module CSPOmegaCombiner where

type Secret512 = [512]
type SigVerdict = Bit

combine5 : Secret512 -> Secret512 -> Secret512 -> Secret512 -> Secret512 -> Secret512
combine5 ss_lwe ss_goppa ss_isog ss_x448 transcript =
  ss_lwe ^ ss_goppa ^ ss_isog ^ ss_x448 ^ transcript

verifyConjunctive3 : SigVerdict -> SigVerdict -> SigVerdict -> SigVerdict
verifyConjunctive3 ok_qhs512 ok_qmq512 ok_sqi512 =
  ok_qhs512 && ok_qmq512 && ok_sqi512

property combiner_preserves_lwe_bijection ss_goppa ss_isog ss_x448 transcript a b =
  (combine5 a ss_goppa ss_isog ss_x448 transcript == combine5 b ss_goppa ss_isog ss_x448 transcript) == (a == b)

property combiner_preserves_goppa_bijection ss_lwe ss_isog ss_x448 transcript a b =
  (combine5 ss_lwe a ss_isog ss_x448 transcript == combine5 ss_lwe b ss_isog ss_x448 transcript) == (a == b)

property combiner_preserves_isogeny_bijection ss_lwe ss_goppa ss_x448 transcript a b =
  (combine5 ss_lwe ss_goppa a ss_x448 transcript == combine5 ss_lwe ss_goppa b ss_x448 transcript) == (a == b)

property conjunctive_sig_requires_all_three qhs qmq sqi =
  (verifyConjunctive3 qhs qmq sqi == True) == ((qhs == True) && (qmq == True) && (sqi == True))
