// OpenQPEP v1.1.4-pc — Cryptol Reference Specification for Calyx Sovereign-Pentad Sovereign-Pentad Combiner
module CSPOmegaCombiner where
  combine5 : [256] -> [256] -> [256] -> [256] -> [256] -> [256]
