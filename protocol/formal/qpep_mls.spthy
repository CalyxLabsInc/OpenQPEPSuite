/*
 * OpenQPEP Official Release 1.1.0 (v1.1.0) — Tamarin Prover Formal Verification Model
 * Protocol: QPEP-MLS TreeKEM Group Key Agreement (Up to 256 Members, Replay Protected)
 * Machine-Checked Lemmas:
 *   1. group_epoch_secrecy: Group messages encrypted under epoch E are unreadable to non-members.
 *   2. immediate_eviction_security: Evicted members at epoch E+1 cannot derive the epoch E+1 secret.
 */
theory QPEP_MLS_TreeKEM_v100
begin

builtins: hashing, symmetric-encryption

functions:
  qsponge_epoch_secret/4,
  qsponge_mls_wrap/3,
  qlx_pk/1,
  qlx_enc/2,
  qlx_dec/2

equations:
  qlx_dec(qlx_enc(qlx_pk(sk), seed), sk) = seed

rule Create_Group_Epoch1:
  let
    epoch_sec = qsponge_epoch_secret(~init_sec, ~path_seed, 'roster_hash', '1')
    wrapped = senc(~path_seed, qsponge_mls_wrap(~path_seed, 'x448_ss', 'roster_hash'))
  in
  [ Fr(~init_sec), Fr(~path_seed), Fr(~msg) ]
  --[ GroupEpochMsg('1', epoch_sec, ~msg) ]->
  [ Out(senc(~msg, epoch_sec)) ]

lemma group_epoch_secrecy:
  "All ep sec m #i. GroupEpochMsg(ep, sec, m) @ #i ==> not (Ex #j. K(m) @ #j)"

end
