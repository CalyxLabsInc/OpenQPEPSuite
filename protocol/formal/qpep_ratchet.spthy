/*
 * OpenQPEP Official Release 1.0.0 (v1.0.0) — Tamarin Prover Formal Verification Model
 * Protocol: QPEP-Ratchet (Post-Quantum Double Ratchet with Rotating Ephemeral QLX + HGC-448 PCS
 *           and Atomic AEAD-Before-Commit CMT-4 CC-512 Chain KDF)
 * Machine-Checked Lemmas:
 *   1. forward_secrecy: Past message keys remain secret even if a later ratchet root key is compromised.
 *   2. post_compromise_security_healing: Rotating ephemeral QLX + X448 KEM re-encapsulation restores secrecy.
 */
theory QPEP_Ratchet_v100
begin

builtins: hashing, symmetric-encryption, diffie-hellman

functions:
  qsponge_root_kdf/3,
  qsponge_chain_step/1,
  qsponge_msg_key/2,
  qlx_pk/1,
  qlx_encaps_ct/2,
  qlx_encaps_ss/2,
  qlx_decaps/2

equations:
  qlx_decaps(qlx_encaps_ct(qlx_pk(sk), r), sk) = qlx_encaps_ss(qlx_pk(sk), r)

rule Init_Ratchet_Epoch0:
  [ Fr(~rk0), Fr(~sk_kem) ]
  --[ RatchetInit(~rk0) ]->
  [ RatchetState('Epoch0', ~rk0, ~sk_kem), Out(qlx_pk(~sk_kem)) ]

rule Send_Ratchet_Message:
  let
    mk = qsponge_msg_key(rk, 'MSG_KEY_V100')
    rk_next = qsponge_chain_step(rk)
    ct = senc(~m, mk)
  in
  [ RatchetState(ep, rk, sk_kem), Fr(~m) ]
  --[ SentMsg(ep, mk, ~m), SecretMsg(ep, mk, ~m) ]->
  [ RatchetState(ep, rk_next, sk_kem), Out(ct) ]

rule PCS_Rekey_Epoch:
  let
    pk_peer = qlx_pk(sk_kem)
    ct_kem = qlx_encaps_ct(pk_peer, ~r_fresh)
    ss_kem = qlx_encaps_ss(pk_peer, ~r_fresh)
    rk_healed = qsponge_root_kdf(rk, ss_kem, 'CALYX_PCS_HEAL_V100')
  in
  [ RatchetState('Epoch0', rk, sk_kem), Fr(~r_fresh), Fr(~sk_kem_new) ]
  --[ PCSHealed('Epoch1', rk_healed, ~r_fresh) ]->
  [ RatchetState('Epoch1', rk_healed, ~sk_kem_new), Out(ct_kem), Out(qlx_pk(~sk_kem_new)) ]

lemma forward_secrecy:
  "All ep mk m #i. SecretMsg(ep, mk, m) @ #i ==> not (Ex #j. K(m) @ #j)"

lemma post_compromise_security_healing:
  "All rk_healed r_fresh #i. PCSHealed('Epoch1', rk_healed, r_fresh) @ #i ==> not (Ex #j. K(rk_healed) @ #j)"

end
